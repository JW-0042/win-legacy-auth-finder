<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LegacyAuthFinder.Core\LegacyAuthFinder.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Many files are parsed in parallel and allocate a lot. Server GC scales with them, workstation GC does not. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AssemblyName>legacy-auth-scan</AssemblyName>
  </PropertyGroup>

</Project>
