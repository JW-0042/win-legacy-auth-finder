<Application x:Class="LegacyAuthFinder.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LegacyAuthFinder.App"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <local:KindBrushConverter x:Key="KindBrush" />
        <local:FileStateBrushConverter x:Key="FileStateBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
    </Application.Resources>
</Application>
